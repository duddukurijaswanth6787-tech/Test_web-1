{
  "name": "boutique-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Central SaaS Backend, Unified SDK, and Super Admin Platform for Boutique Websites",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:sdk": "npm --workspace=packages/sdk run dev",
    "dev:admin": "npm --workspace=apps/super-admin run dev",
    "build:sdk": "npm --workspace=packages/sdk run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:admin": "npm --workspace=apps/super-admin run build",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "waas",
    "boutique",
    "subscription",
    "sdk",
    "saas"
  ],
  "author": "Freelance Agency",
  "license": "MIT"
}
